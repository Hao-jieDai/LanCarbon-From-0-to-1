1}},"key":"EQkC2gVp7J"}],"key":"RTuMpBoFF9"},{"type":"paragraph","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"If the selected texts are too large, missing or only partly parsed, the request stops before sending. Reduce the selection or check the source/OCR; no part is silently omitted. Full text means successfully extracted text, not verified visual coverage of every table or scanned page. Sending whole texts can cost more input tokens than sending a few retrieved passages. ","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"mRzWKBlgpG"},{"type":"strong","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"Usage","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"k6yvWbKIKU"}],"key":"JI2COIO9xx"},{"type":"text","value":" records the Chat request, including returned Thinking usage. No retrieval requests are added by this mode.","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"xReSGas3u2"}],"key":"SarYq83G0e"},{"type":"paragraph","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"text","value":"The installed application includes the local PaperQA runtime; no separate Python, Docker or WSL installation is required. Existing model connections and files are reused.","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"AgPLE2AgWS"}],"key":"OfCrVhaYiK"},{"type":"heading","depth":3,"position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"text","value":"Retrieval settings","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"SXz9yuAq7X"}],"identifier":"retrieval-settings","label":"Retrieval settings","html_id":"retrieval-settings","implicit":true,"key":"xCQsjY1W5q"},{"type":"paragraph","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"Saved retrieval connections remain available in settings and old chat records retain their retrieval labels. PaperQA full-text questions do not use these connections. For a build using the retrieval mode, configure Embedding and optional Rerank in ","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"ZM11qEAkgG"},{"type":"strong","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"AI Settings → Retrieval","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"F98CFX5KWv"}],"key":"Pttu8Brfez"},{"type":"text","value":". Refresh the appropriate model catalogue, save and test the chosen model; catalogue availability does not guarantee account access. When you ask a question, extraction, changed-source checks and vector preparation run automatically. Existing vectors are reused when the text and embedding model are unchanged. Retrieval selects passages within a bounded context, so selection does not mean the whole source was sent. Evidence identifies semantic retrieval, reranking or keyword fallback. Auxiliary requests and failed attempts appear in Usage. Local text/index tools provide optional inspection and cache clearing; clearing derived indexes preserves originals and chats.","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"YQcK92xy4J"}],"key":"fXKMKbz0lG"},{"type":"heading","depth":3,"position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"Reading assistance","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"JLdhfNZrw6"}],"identifier":"reading-assistance","label":"Reading assistance","html_id":"reading-assistance","implicit":true,"key":"IZdoia5k92"},{"type":"paragraph","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"Use document questions to locate passages, explain concepts and compare studies. Before incorporating a conclusion into research, open its citation and check the original amount and unit, formula variable definitions, scenario and who owns or bears the reported loss. A local calculation can check arithmetic, but does not establish that the model selected the right entity or scenario.","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"KlT6quCaXH"}],"key":"cLZZLUW8Kb"},{"type":"heading","depth":3,"position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"text","value":"Read and check citations","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"j6ysBEtr1J"}],"identifier":"read-and-check-citations","label":"Read and check citations","html_id":"read-and-check-citations","implicit":true,"key":"RSjkyGBmbi"},{"type":"paragraph","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"Replies cite saved passages as ","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"KeyuvM84eL"},{"type":"strong","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"[S1]","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"VQNTqxNcMM"}],"key":"Ffl0EFHT7N"},{"type":"text","value":", ","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"akwagb04QY"},{"type":"strong","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"[S2]","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"vPrnwJDdgG"}],"key":"XHziAU61Z0"},{"type":"text","value":", etc. Click a citation or expand ","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"yOPzHxD0Ai"},{"type":"strong","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":