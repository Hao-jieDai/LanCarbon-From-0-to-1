R3bA"},{"type":"inlineCode","value":"gh-pages","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"YeIhZ26Ozd"},{"type":"text","value":".","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"FLJLqi1UST"}],"key":"l7EGL4Ba45"},{"type":"paragraph","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"text","value":"Make a meaningful publication only when the public result is ready. Small local edits can accumulate before the next Build and Update.","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"MCwe1NBnNS"}],"key":"SuTBqUe9Cn"},{"type":"thematicBreak","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"ZUOhWn3BqL"},{"type":"heading","depth":3,"position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"中文","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"n8kfPKDDaZ"}],"identifier":"id","label":"中文","html_id":"id","implicit":true,"key":"mRCiNnVbnz"},{"type":"heading","depth":2,"position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"text","value":"更新已经发布的 Book","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"X1fnDUZHXT"}],"identifier":"id-book","label":"更新已经发布的 Book","html_id":"id-book","implicit":true,"key":"phUrYHKLZJ"},{"type":"paragraph","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"text","value":"Book 建立连接后，不需要每次修改都创建新仓库，应继续使用已保存的绑定。","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"EeQ7zeGOQQ"}],"key":"LwAay4OPn2"},{"type":"code","lang":"text","value":"在 LanCarbon 中编辑\n→ 等待 All changes saved\n→ Build / Rebuild Website\n→ 用 Open Website 本地检查\n→ 打开 Publish\n→ Update Website\n→ 等待部署\n→ Open Pages 并验证","position":{"start":{"line":47,"column":1},"end":{"line":56,"column":1}},"key":"xqJI0L955w"},{"type":"paragraph","position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"children":[{"type":"text","value":"除非需要额外保存源文件备份，否则日常更新不包含 Export。每本 Book 的 Build 位置和仓库绑定都会被记住。","position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"key":"oIrzZ8hp82"}],"key":"cXPfWpkmVo"},{"type":"paragraph","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"children":[{"type":"text","value":"Publish 窗口会比较当前 Book 与最新成功 Build。如果 build outdated，就先重新构建。如果 Git 网络检查失败，更新按钮可能暂时不可用，直到恢复连接并刷新检查。更新失败不会删除已发布网站；线上仍保留上一次成功 commit。","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"key":"PvQ88hjud8"}],"key":"fi4m27ecEY"},{"type":"paragraph","position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"children":[{"type":"text","value":"成功后，对照 Published website 显示的 commit/时间与本次操作。GitHub Pages 部署和缓存可能存在延迟；仍显示旧文字时，稍等后进行浏览器完整刷新。Open Repository 可以确认最新 commit 是否已经到达 ","position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"key":"s259OA6glX"},{"type":"inlineCode","value":"gh-pages","position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"key":"HiXrVMhri6"},{"type":"text","value":"。","position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"key":"hhEw2venz8"}],"key":"cLZivEn6Nt"},{"type":"paragraph","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"children":[{"type":"text","value":"只有公开结果准备好时才需要发布。多次很小的本地修改可以积累到一起，再执行一次 Build 和 Update。","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"wB1JOqESEB"}],"key":"MxbDKeHIeI"}],"key":"M1i9iWVmHZ"}],"key":"MCRPYZtdkn"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Publishing Your First Website","short_title":"Publishing Your First Website","url":"/first-publish","group":"LanCarbon: From 0 to 1"},"next":{"title":"Troubleshooting Common Problems","short_title":"Troubleshooting Common Problems","url":"/troubleshooting","group":"L